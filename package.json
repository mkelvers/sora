{
	"name": "sora",
	"private": true,
	"license": "AGPL-3.0-only",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "bun install --frozen-lockfile && docker compose up -d --wait && turbo run dev",
		"build": "turbo run build",
		"check": "turbo run check",
		"test": "bun test tooling/lint.test.ts && turbo run test",
		"test:integration": "turbo run test:integration",
		"lint": "oxlint -c tooling/directives.json --disable-nested-config && oxlint",
		"lint:fix": "oxlint -c tooling/directives.json --disable-nested-config && oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"audit": "bun audit",
		"fix": "ultracite fix"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.87.0",
		"@types/bun": "latest",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"turbo": "^2.11.13",
		"ultracite": "8.0.2"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "~0.25.4"
		},
		"@graphql-tools/utils": "^12.0.1",
		"@pgtyped/cli": {
			"glob": "^14.0.6",
			"minimatch": "^11.0.9",
			"tinypool": "^2.2.0"
		},
		"graphql-config": {
			"minimatch": "^11.0.9"
		}
	},
	"packageManager": "bun@1.4.0",
	"patchedDependencies": {
		"braces@3.0.3": "patches/braces@3.0.3.patch"
	}
}
