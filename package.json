{
	"name": "sora",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "docker compose up -d --wait && turbo run dev",
		"build": "turbo run build",
		"check": "turbo run check",
		"test": "turbo run test",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"turbo": "^2.11.4"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"packageManager": "bun@1.4.2"
}
