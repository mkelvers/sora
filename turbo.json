{
	"$schema": "https://v2-11-10.turborepo.dev/schema.json",
	"agentGuidance": false,
	"ui": "stream",
	"futureFlags": {
		"affectedUsingTaskInputs": true
	},
	"globalDependencies": ["tsconfig.json"],
	"tasks": {
		"dev": {
			"dependsOn": ["^db:migrate"],
			"persistent": true,
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".svelte-kit/output/**", "build/**"]
		},
		"check": {
			"outputLogs": "errors-only"
		},
		"test": {
			"inputs": ["$TURBO_DEFAULT$", ".env", "../../.env.test"]
		},
		"db:migrate": {
			"cache": false
		}
	}
}
