{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "stream",
	"globalDependencies": ["tsconfig.json"],
	"tasks": {
		"dev": {
			"dependsOn": ["^db:migrate"],
			"persistent": true,
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".svelte-kit/output/**", "build/**"]
		},
		"check": {},
		"test": {
			"inputs": ["$TURBO_DEFAULT$", ".env"]
		},
		"db:migrate": {
			"cache": false
		}
	}
}
