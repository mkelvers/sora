{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 100,
	"singleQuote": false,
	"semi": true,
	"trailingComma": "all",
	"objectWrap": "preserve",
	"htmlWhitespaceSensitivity": "ignore",
	"sortImports": {},
	"sortTailwindcss": {
		"stylesheet": "./apps/web/src/routes/layout.css",
		"functions": ["cn", "cva", "clsx"]
	},
	"svelte": true,
	"ignorePatterns": ["bun.lock", "packages/core/drizzle/**", "vendor/**", "**/*.generated.ts"]
}
