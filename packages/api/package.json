{
  "name": "@sora/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "bun --env-file=../core/.env --env-file=.env test",
    "start": "bun --env-file=../core/.env --env-file=.env src/main.ts",
    "dev": "bun --env-file=../core/.env --env-file=.env --watch src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../core/.env src/auth/migrate.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.4",
    "@sora/core": "workspace:*",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11"
  }
}
