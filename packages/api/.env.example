# The core's variables (DATABASE_URL, TMDB_READ_ACCESS_TOKEN, STREAM_SIGNING_SECRET) are read from packages/core/.env.
PORT=3000
# The API's public base URL.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Comma-separated browser origins allowed to call the API with credentials; `*.` matches subdomains.
TRUSTED_ORIGINS=https://*.mkelvers.tech,http://localhost:3000,http://localhost:5173
# Set to true behind a reverse proxy that sets X-Forwarded-For; only then is that header believed.
TRUST_PROXY=false
