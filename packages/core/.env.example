# Shared by the API, scheduler, migrations, and account-creation script.
# Copy to packages/core/.env. Required values below must be filled before starting.

# Required. Ready for the local PostgreSQL service in compose.yaml.
# If you change its host port or credentials, update this URL to match.
DATABASE_URL=postgres://sora:sora@localhost:5432/sora

# Required. Signs stream proxy tokens. Generate a new value with: openssl rand -base64 48
# Use at least 32 characters and a different value from AUTH_SECRET and WEB_CLIENT_KEY.
STREAM_SIGNING_SECRET=

# Required. Authorizes the web app's playback and stream requests. At least 32 characters.
# Generate with: openssl rand -base64 48
# Copy this exact value into WEB_CLIENT_KEY in apps/web/.env too.
WEB_CLIENT_KEY=

# Required. Create a TMDB account, then request API access at https://www.themoviedb.org/settings/api
# Copy the "API Read Access Token", not the API key. Used for series and episode metadata.
TMDB_READ_ACCESS_TOKEN=

# Required. Create an account at https://animeschedule.net and open Account settings -> API applications.
# Create an application and copy its token here. Used for English dub release times.
# The current configuration requires this even if you only watch subtitled anime.
ANIME_SCHEDULE_API_KEY=

# Required. Signs session tokens. Generate with: openssl rand -base64 48
# Use at least 32 characters. Keep this value stable; changing it signs out existing sessions.
AUTH_SECRET=

# Optional. Defaults to http://localhost:3000. Set to the API's public origin when hosting it.
# If you change PORT, update this and SORA_API_URL in apps/web/.env to match.
# AUTH_URL=http://localhost:3000

# Optional. Empty by default. Additional origins allowed to sign in, comma-separated.
# Include the internal origin the web app reaches the API by if it differs from AUTH_URL.
# AUTH_TRUSTED_ORIGINS=

# Optional. Defaults to 127.0.0.1. Use 0.0.0.0 to reach the API from another machine or container.
# Keep it behind the web app or a proxy that sets X-Forwarded-For; sign-in limits trust that header.
# HOST=127.0.0.1

# Optional. API port; defaults to 3000.
# PORT=3000
