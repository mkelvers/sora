# PostgreSQL connection string; matches compose.yaml.
DATABASE_URL=postgres://sora:sora@localhost:5432/sora
# At least 32 random characters; signs stream proxy tokens. Generate with: openssl rand -base64 48
STREAM_SIGNING_SECRET=
# At least 32 random characters; the web app sends it (as WEB_CLIENT_KEY in its own .env) with playback and stream
# requests, and the API serves media to nothing else. Generate with: openssl rand -base64 48
WEB_CLIENT_KEY=
# TMDB API read access token (Settings -> API -> "API Read Access Token").
TMDB_READ_ACCESS_TOKEN=
# AnimeSchedule application token (Account settings -> API applications).
ANIME_SCHEDULE_API_KEY=
# At least 32 random characters; signs session tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=
# The API's public origin. Defaults to http://localhost:3000.
# AUTH_URL=
# Other origins allowed to sign in, comma-separated, such as the internal URL the web app reaches the API by.
# AUTH_TRUSTED_ORIGINS=
# Address the API listens on. Defaults to 127.0.0.1, so only this machine reaches it; use 0.0.0.0 to serve others,
# but then keep it behind the web app or a proxy that sets X-Forwarded-For (sign-in limits trust it).
# HOST=
