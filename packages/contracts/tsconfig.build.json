{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "ignoreDeprecations": "6.0",
        "paths": {
            "@soraorg/contracts/*": ["src/*"]
        },
        "declaration": true,
        "declarationMap": true,
        "outDir": "dist",
