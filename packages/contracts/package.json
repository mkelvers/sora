{
    "name": "@soraorg/contracts",
    "version": "0.0.3",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/soraorg/sora-sdk.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./client": "./dist/client.js",
        "./graphql/anilist": "./dist/graphql/anilist.js",
        "./audio": "./dist/audio.js",
        "./search": "./dist/search.js",
        "./season": "./dist/season.js",
        "./types": "./dist/types.js",
        "./catalog/*": "./dist/catalog/*.js",
        "./catalog/franchise/*": "./dist/catalog/franchise/*.js",
        "./catalog/synopsis/*": "./dist/catalog/synopsis/*.js",
        "./contracts": "./dist/contracts/index.js",
        "./contracts/*": "./dist/contracts/*.js",
        "./maintenance/*": "./dist/maintenance/*.js",
        "./playback/*": "./dist/playback/*.js",
        "./player/*": "./dist/player/*.js",
        "./providers/*": "./dist/providers/*.js",
        "./user/*": "./dist/user/*.js",
        "./user/*/*": "./dist/user/*/*.js"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc --noEmit",
        "prepublishOnly": "bun run build"
    },
    "dependencies": {
        "@graphql-typed-document-node/core": "^3.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "typescript": "catalog:"
    }
}
