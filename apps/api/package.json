		"test": "bun test --isolate"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@sora/core": "workspace:*",
		"@sora/shared": "workspace:*",
		"hono": "^4.13.8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2"
	}
}
