{
	"name": "@sora/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/main.ts",
		"./contract": "./src/contract.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p .",
		"start": "bun --env-file=../../packages/core/.env src/main.ts",
