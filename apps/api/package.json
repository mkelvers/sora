{
	"name": "@sora/api",
	"version": "0.0.1",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"exports": {
		"./contract": "./src/openapi/routes.ts",
		"./models": "./src/models.ts",
		"./schemas": "./src/openapi/schemas.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p .",
		"start": "bun --env-file=../../packages/core/.env src/main.ts",
		"dev": "bun --env-file=../../packages/core/.env --watch src/main.ts",
		"test": "bun test --no-env-file --env-file=../../.env.test --path-ignore-patterns='**/*.integration.test.ts'",
		"test:integration": "bun test --no-env-file --env-file=../../packages/core/.env --preload ../../packages/core/test/rollback.ts integration.test"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@sora/core": "workspace:*",
		"@sora/shared": "workspace:*",
		"hono": "^4.13.16",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2"
	}
}
