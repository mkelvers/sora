# Copy to apps/web/.env. Both values are required and stay on the web server.

# Ready for local development. Base URL the web server uses to reach the API, without /v1.
# Update this if the API uses a different host or PORT.
SORA_API_URL=http://localhost:3000

# Required. Same value as WEB_CLIENT_KEY in packages/core/.env.
WEB_CLIENT_KEY=
