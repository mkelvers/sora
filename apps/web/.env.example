# Copy to apps/web/.env. Both values are required and stay on the web server.

# Ready for local development. Base URL the web server uses to reach the API, without /v1.
# Update this if the API uses a different host or PORT.
SORA_API_URL=http://localhost:3000

# Required. Same value as WEB_CLIENT_KEY in packages/core/.env.
WEB_CLIENT_KEY=

# Production only, behind a reverse proxy (deploy/compose.yaml sets these). The web server takes the
# protocol, and so whether cookies are Secure and which origin form posts must come from, from the
# proxy's X-Forwarded-Proto. Without it, it assumes https, and signing in over plain http fails.
# PROTOCOL_HEADER=x-forwarded-proto
# Sign-in limits count each visitor by address; behind a proxy, read it from X-Forwarded-For.
# XFF_DEPTH is how many proxies stand in front: 1 for one reverse proxy.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
